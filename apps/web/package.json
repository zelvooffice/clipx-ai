{
  "name": "clipx-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLIPX_ENV=development DEV_AUTH_EMAIL=dev@example.com vite dev --port 3001",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "vite build && cf deploy --prebuilt",
    "hash-password": "node scripts/hash-password.mjs",
    "dev:next": "next dev",
    "build:vinext": "vite build",
    "deploy:r2": "CLIPX_ASSETS=r2 vite build && node scripts/upload-static.mjs && rm -rf .cloudflare/output/v0/workers/default/assets && cf deploy --prebuilt"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "framer-motion": "14.12.0",
    "jose": "6.2.17",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.15",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "^1.3.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.30",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "vinext": "^1.4.5",
    "vite": "^8.3.0",
    "vitest": "5.1.0",
    "wrangler": "^4.160.1"
  }
}
