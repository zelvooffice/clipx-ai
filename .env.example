# CLIPX AI — processing server configuration (copy to .env; never commit .env).
# REQUIRED values must be set for production. Generate secrets locally:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"   -> TOKEN_ENCRYPTION_KEYS
#   openssl rand -hex 32                                                              -> INTERNAL_API_SECRET

ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Core (docker-compose builds DATABASE_URL / REDIS_URL from these) ---
POSTGRES_PASSWORD=                      # REQUIRED
PUBLIC_APP_URL=https://clipx.example.com   # REQUIRED: dashboard origin (OAuth redirect URIs derive from it)
API_PUBLIC_URL=https://clipx-api.example.com

# --- Security ---
TOKEN_ENCRYPTION_KEYS=                  # REQUIRED: base64 32-byte key(s), comma separated, newest first
INTERNAL_API_SECRET=                    # REQUIRED: same value as the web Worker secret (>= 32 chars)
AUTHORIZED_EMAILS=                      # REQUIRED: comma separated allowlist (also enforced by Cloudflare Access)
CF_ACCESS_TEAM_DOMAIN=                  # optional: verify Access JWTs directly at the API
CF_ACCESS_AUD=
RATE_LIMIT_PER_MINUTE=240

# --- Twitch ---
TWITCH_CLIENT_ID=                       # REQUIRED for Twitch features
TWITCH_CLIENT_SECRET=
TWITCH_TARGET_LOGIN=lacy
TWITCH_EVENTSUB_TRANSPORT=websocket     # websocket (default, no public endpoint) | webhook
TWITCH_EVENTSUB_SECRET=                 # webhook transport only (10-100 ASCII chars)
TWITCH_WEBHOOK_CALLBACK_URL=            # webhook transport only: https://<API_DOMAIN>/webhooks/twitch/eventsub
TWITCH_POLL_INTERVAL_S=60

# --- TikTok ---
TIKTOK_CLIENT_KEY=                      # REQUIRED for publishing
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload,video.list
TIKTOK_PULL_URL_PREFIX=                 # optional: URL prefix verified in the TikTok portal (enables PULL_FROM_URL)

# --- Storage (Cloudflare R2) ---
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=                          # REQUIRED in production
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipx-media
R2_PUBLIC_BASE_URL=                     # optional: public custom domain (only for TikTok PULL_FROM_URL)

# --- AI ---
ANTHROPIC_API_KEY=                      # optional: contextual analysis + captions (heuristic fallback otherwise)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
WHISPER_MODEL=small                     # tiny.en | small | medium | large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# --- Authorized live feed (MediaMTX) ---
INGEST_PUBLISH_PASSWORD=                # REQUIRED: given to the channel for its OBS second output
INGEST_READ_PASSWORD=                   # REQUIRED: used by the analyzer below
LIVE_INGEST_URL=rtmp://mediamtx:1935/lacy?user=analyzer&pass=CHANGE_ME_TO_INGEST_READ_PASSWORD
BUFFER_SECONDS=240
SEGMENT_SECONDS=2
RENDER_PRESET=veryfast
RENDER_CRF=19

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=                # REQUIRED: publishes the API at API_PUBLIC_URL without open ports

# --- Optional discovery ---
YOUTUBE_API_KEY=

# --- Per-visit dashboard password (asked in every new tab, for every user) ---
DASHBOARD_PASSWORD_HASH=                # REQUIRED in production: python -m app.security.password
UNLOCK_TTL_MINUTES=480                  # maximum length of an unlocked session
UNLOCK_MAX_ATTEMPTS=5                   # wrong passwords before a 15-minute lockout
